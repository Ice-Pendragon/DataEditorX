{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build DataEditorX Debug",
			"type": "shell",
			"command": "${env:WINDIR}\\Microsoft.NET\\Framework\\v4.0.30319\\MSBuild.exe",
			"args": [
				"${workspaceFolder}\\DataEditorX.sln",
				"/p:Configuration=Debug",
				"/p:Platform=Any CPU",
				"/v:minimal"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build DataEditorX Release",
			"type": "shell",
			"command": "${env:WINDIR}\\Microsoft.NET\\Framework\\v4.0.30319\\MSBuild.exe",
			"args": [
				"${workspaceFolder}\\DataEditorX.sln",
				"/p:Configuration=Release",
				"/p:Platform=Any CPU",
				"/v:minimal"
			],
			"problemMatcher": "$msCompile"
		}
	]
}
